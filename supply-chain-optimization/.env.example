# Docker Compose defaults. Change credentials before deploying anywhere public.
MYSQL_DATABASE=supply_chain
MYSQL_USER=supply_user
MYSQL_PASSWORD=supply_password
MYSQL_ROOT_PASSWORD=change_root_password
DATABASE_URL=mysql+pymysql://supply_user:supply_password@db:3306/supply_chain
API_BASE_URL=http://api:8000
SAFETY_STOCK_DAYS=7
